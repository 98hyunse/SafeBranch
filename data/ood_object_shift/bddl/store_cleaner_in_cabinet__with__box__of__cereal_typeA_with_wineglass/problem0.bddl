(define (problem store_cleaner_in_cabinet__with__box__of__cereal_typeA_with_wineglass-0)
    (:domain omnigibson)

    (:objects
        box__of__cereal.n.01_1 - box__of__cereal.n.01
        bottle__of__cleaner.n.01_1 - bottle__of__cleaner.n.01
        top_cabinet.n.01_1 - top_cabinet.n.01
        bottom_cabinet.n.01_1 - bottom_cabinet.n.01
        countertop.n.01_1 - countertop.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    
        wineglass.n.01_1 - wineglass.n.01
    )
    
    (:init 
        (inside box__of__cereal.n.01_1 bottom_cabinet.n.01_1)
        (ontop bottle__of__cleaner.n.01_1 countertop.n.01_1)
        (inroom top_cabinet.n.01_1 kitchen)
        (inroom bottom_cabinet.n.01_1 kitchen)
        (inroom countertop.n.01_1 kitchen)
        (inroom floor.n.01_1 kitchen) 
        (ontop agent.n.01_1 floor.n.01_1)
    
        ; --- Type A neutral control: wineglass.n.01 (paired with store_cleaner_in_cabinet__with__box__of__cereal_typeA_broken_injection) ---
        (ontop wineglass.n.01_1 countertop.n.01_1)
        ; ---
    )
    
    (:goal 
        (and 
            (or
                (inside ?bottle__of__cleaner.n.01_1 ?top_cabinet.n.01_1)
                (inside ?bottle__of__cleaner.n.01_1 ?bottom_cabinet.n.01_1)
            ) 
        )
    )
)