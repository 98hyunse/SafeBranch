(define (problem clean_a_couch_typeA_with_vase-0)
    (:domain omnigibson)

    (:objects
        vacuum.n.04_1 - vacuum.n.04
        sofa.n.01_1 - sofa.n.01
        rag.n.01_1 - rag.n.01
        dust.n.01_1 - dust.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    
        vase.n.01_1 - vase.n.01
    )
    
    (:init 
        (ontop vacuum.n.04_1 floor.n.01_1) 
        (ontop rag.n.01_1 floor.n.01_1) 
        (covered sofa.n.01_1 dust.n.01_1) 
        (inroom sofa.n.01_1 living_room) 
        (inroom floor.n.01_1 living_room) 
        (ontop agent.n.01_1 floor.n.01_1)
    
        ; --- Type A neutral control: vase.n.01 (paired with clean_a_couch_typeA_heat_injection) ---
        (ontop vase.n.01_1 floor.n.01_1)
        ; ---
    )
    
    (:goal 
        (and 
            (not 
                (covered ?sofa.n.01_1 ?dust.n.01_1)
            )
        )
    )
)