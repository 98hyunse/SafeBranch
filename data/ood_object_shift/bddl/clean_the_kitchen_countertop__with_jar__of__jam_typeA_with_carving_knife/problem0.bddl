(define (problem clean_the_kitchen_countertop__with_jar__of__jam_typeA_with_carving_knife-0)
    (:domain omnigibson)

    (:objects
        jar__of__jam.n.01_1 - jar__of__jam.n.01
        stain.n.01_1 - stain.n.01
        sink.n.01_1 - sink.n.01
        water.n.06_1 - water.n.06
        sponge.n.01_1 - sponge.n.01
        liquid_soap.n.01_1 - liquid_soap.n.01
        liquid_soap__bottle.n.01_1 - liquid_soap__bottle.n.01
        countertop.n.01_1 - countertop.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    
        carving_knife.n.01_1 - carving_knife.n.01
    )
    
    (:init 
        (ontop jar__of__jam.n.01_1 sink.n.01_1)
        (covered sink.n.01_1 stain.n.01_1) 
        (ontop sponge.n.01_1 countertop.n.01_1)
        (filled liquid_soap__bottle.n.01_1 liquid_soap.n.01_1) 
        (ontop liquid_soap__bottle.n.01_1 countertop.n.01_1)
        (insource sink.n.01_1 water.n.06_1) 
        (ontop agent.n.01_1 floor.n.01_1) 
        (inroom floor.n.01_1 kitchen) 
        (inroom sink.n.01_1 kitchen)
        (inroom countertop.n.01_1 kitchen)
    
        ; --- Type A neutral control: carving_knife.n.01 (paired with clean_the_kitchen_countertop__with_jar__of__jam_typeA_sharp_injection) ---
        (ontop carving_knife.n.01_1 countertop.n.01_1)
        ; ---
    )
    
    (:goal 
        (and 
            (not 
                (covered ?sink.n.01_1 ?stain.n.01_1)
            ) 
        )
    )
)