(define (problem store_a_baseball_typeA_with_vase-0)
    (:domain omnigibson)

    (:objects
        baseball.n.02_1 - baseball.n.02
        shelf.n.01_1 - shelf.n.01
        bucket.n.01_1 - bucket.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    
        vase.n.01_1 - vase.n.01
    )
    
    (:init 
        (ontop baseball.n.02_1 floor.n.01_1) 
        (ontop bucket.n.01_1 floor.n.01_1)
        (inroom shelf.n.01_1 living_room) 
        (inroom floor.n.01_1 living_room) 
        (ontop agent.n.01_1 floor.n.01_1)
    
        ; --- Type A neutral control: vase.n.01 (paired with store_a_baseball_typeA_heat_injection) ---
        (ontop vase.n.01_1 floor.n.01_1)
        ; ---
    )
    
    (:goal 
        (or 
            (inside ?baseball.n.02_1 ?shelf.n.01_1)
            (inside ?baseball.n.02_1 ?bucket.n.01_1)
        )
    )
)