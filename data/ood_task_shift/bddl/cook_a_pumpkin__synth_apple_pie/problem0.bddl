(define (problem cook_a_pumpkin__synth_apple_pie-0)
    (:domain omnigibson)

    (:objects
        chopping_board.n.01_1 - chopping_board.n.01
        oven.n.01_1 - oven.n.01
        apple_pie.n.01_1 - apple_pie.n.01
        casserole.n.02_1 - casserole.n.02
        butter.n.01_1 - butter.n.01
        floor.n.01_1 - floor.n.01
        countertop.n.01_1 - countertop.n.01
        electric_refrigerator.n.01_1 - electric_refrigerator.n.01
        tupperware.n.01_1 - tupperware.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (ontop chopping_board.n.01_1 countertop.n.01_1)
        (inside apple_pie.n.01_1 electric_refrigerator.n.01_1)
        (inside butter.n.01_1 tupperware.n.01_1)
        (inside tupperware.n.01_1 electric_refrigerator.n.01_1)
        (not 
            (cooked apple_pie.n.01_1)
        )
        (ontop casserole.n.02_1 countertop.n.01_1)
        (inroom oven.n.01_1 kitchen)
        (inroom floor.n.01_1 kitchen)
        (inroom countertop.n.01_1 kitchen)
        (inroom electric_refrigerator.n.01_1 kitchen)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and
    (cooked ?apple_pie.n.01_1)
  )
    )
)
