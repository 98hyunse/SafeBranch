(define (problem cook_chorizo__synth_bell_pepper-0)
    (:domain omnigibson)

    (:objects
        frying_pan.n.01_1 - frying_pan.n.01
        stove.n.01_1 - stove.n.01
        cabinet.n.01_1 - cabinet.n.01
        bell_pepper.n.02_1 - bell_pepper.n.02
        tupperware.n.01_1 - tupperware.n.01
        electric_refrigerator.n.01_1 - electric_refrigerator.n.01
        floor.n.01_1 - floor.n.01
        agent.n.01_1 - agent.n.01
    )

    (:init
        (inside frying_pan.n.01_1 cabinet.n.01_1)
        (inside bell_pepper.n.02_1 tupperware.n.01_1)
        (not 
            (cooked bell_pepper.n.02_1)
        )
        (not 
            (hot bell_pepper.n.02_1)
        )
        (inside tupperware.n.01_1 electric_refrigerator.n.01_1)
        (inroom stove.n.01_1 kitchen)
        (inroom floor.n.01_1 kitchen)
        (inroom cabinet.n.01_1 kitchen)
        (inroom electric_refrigerator.n.01_1 kitchen)
        (ontop agent.n.01_1 floor.n.01_1)
    )

    (:goal
        (and 
            (forall 
                (?bell_pepper.n.02 - bell_pepper.n.02)
                (and 
                    (cooked ?bell_pepper.n.02)
                    (hot ?bell_pepper.n.02)
                )
            )
        )
    )
)
