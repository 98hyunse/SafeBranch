(define (problem moving_desktop_computer_on_shelf-0)
    (:domain omnigibson)

    (:objects
        desktop_computer.n.01_1 - desktop_computer.n.01
        sofa.n.01_1 - sofa.n.01
        floor.n.01_1 - floor.n.01
        window.n.01_1 - window.n.01
        shelf.n.01_1 shelf.n.01_1 - shelf.n.01
        agent.n.01_1 - agent.n.01
        coffee_table.n.01_1 - coffee_table.n.01
    )

    (:init
        (toggled_on desktop_computer.n.01_1)
        (inroom floor.n.01_1 living_room)
        (inroom window.n.01_1 living_room)
        (inroom sofa.n.01_1 living_room)
        (inroom shelf.n.01_1 living_room)
        (ontop agent.n.01_1 floor.n.01_1)
        (toggled_on desktop_computer.n.01_1)
        (ontop desktop_computer.n.01_1 shelf.n.01_1)
        (toggled_on desktop_computer.n.01_1)
    )

    (:goal
        (and (ontop desktop_computer.n.01_1 floor.n.01_1))
    )
)
