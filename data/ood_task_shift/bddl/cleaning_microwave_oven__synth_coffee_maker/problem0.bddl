        dust.n.01_1 - dust.n.01
        coffee_maker.n.01_1 - coffee_maker.n.01
        rag.n.01_1 - rag.n.01
        countertop.n.01_1 - countertop.n.01
        ashcan.n.01_1 - ashcan.n.01
