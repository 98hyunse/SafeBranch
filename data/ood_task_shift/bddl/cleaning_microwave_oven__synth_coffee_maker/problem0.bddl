    )

    (:init
        (covered coffee_maker.n.01_1 dust.n.01_1)
        (covered coffee_maker.n.01_1 stain.n.01_1)
        (ontop rag.n.01_1 countertop.n.01_1)
        (ontop ashcan.n.01_1 floor.n.01_1)
        (inroom coffee_maker.n.01_1 kitchen)
